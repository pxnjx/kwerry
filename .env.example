# ============================================================================
#  Kwerry — local configuration
#  Copy to .env and fill in. This file is the whole setup: there is no
#  sign-up screen and no database to configure by hand.
#      cp .env.example .env      (Windows: copy .env.example .env)
#  Restart the server after every change here.
# ============================================================================

# --- 1. SerpAPI (https://serpapi.com) — required ------------------------------
SERPAPI_API_KEY=your_serpapi_key_here

# --- 2. Your account --------------------------------------------------------
# Created automatically the FIRST time the server starts with an empty
# database. Leave SEED_ADMIN_PASSWORD empty and Kwerry generates a random
# one and prints it once in the terminal — copy it, then change it under
# Settings once you are in.
#
# This only runs while the database has no users. If the database already
# has your account, changing these does nothing: to reset a forgotten
# password use Settings, or delete data/keyword-research.db to start over
# (that erases all search history).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- 3. Admin rights --------------------------------------------------------
# The only account allowed to manage SerpAPI keys, view billing, and run
# backup/restore. Set this to the SAME value as SEED_ADMIN_USERNAME above.
#
# The server listens on every network interface, not just localhost, so
# anyone on your network can reach the port. Leaving this empty means every
# account can touch keys, billing and backups — fine for one person on a
# laptop, not for an untrusted network.
ADMIN_USERNAME=

# --- 4. Sign-up (leave off for local use) ------------------------------------
# Off by default: accounts come from section 2, and the "Create account" tab
# is hidden. Set to "true" only if you deliberately want the login screen to
# offer registration — remember anyone who reaches the port can then make an
# account and spend your SerpAPI quota. Restart after changing.
ENABLE_SIGNUP=false

# --- 5. Port ----------------------------------------------------------------
PORT=8765

# --- 6. HTTPS / reverse proxy ----------------------------------------------
# Leave off for plain http://localhost. Set to "true" ONLY when a reverse proxy
# you control terminates TLS and sets X-Forwarded-Proto — that is what marks the
# session cookie "Secure". Without a proxy the header is attacker-controlled;
# leaving this off is the safe default. Restart after changing.
TRUST_PROXY=false

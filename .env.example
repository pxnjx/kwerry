# SerpAPI (https://serpapi.com) — required
SERPAPI_API_KEY=your_serpapi_key_here

# Port for the app (default 8765)
PORT=8765

# First-run admin account (optional but recommended)
# If omitted, Kwerry generates a random password and prints it once in the server log.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
